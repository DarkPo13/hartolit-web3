{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OwnFunctionLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": [
        "arn:aws:logs:eu-central-1:ACCOUNT_ID:log-group:/aws/lambda/hartolit-field-pa*-staging-Web*",
        "arn:aws:logs:eu-central-1:ACCOUNT_ID:log-group:/aws/lambda/s-WebRevalidationEventsSubscriber*",
        "arn:aws:logs:*:ACCOUNT_ID:log-group:/aws/lambda/us-east-1.hartolit-field-passport-staging-WebEdgeFn-*"
      ]
    },
    {
      "Sid": "AssetsAndPageCache",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::hartolit-field-passport-staging-webassetsbucket-*",
        "arn:aws:s3:::hartolit-field-passport-staging-webassetsbucket-*/*"
      ]
    },
    {
      "Sid": "RevalidationQueue",
      "Effect": "Allow",
      "Action": [
        "sqs:SendMessage",
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:ChangeMessageVisibility",
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl"
      ],
      "Resource": "arn:aws:sqs:eu-central-1:ACCOUNT_ID:hartolit-field-passport-staging-WebRevalidationEventsQueue-*"
    },
    {
      "Sid": "RevalidationTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:BatchGetItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:ConditionCheckItem",
        "dynamodb:DeleteItem",
        "dynamodb:DescribeTable",
        "dynamodb:GetItem",
        "dynamodb:GetRecords",
        "dynamodb:GetShardIterator",
        "dynamodb:PutItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:UpdateItem"
      ],
      "Resource": "arn:aws:dynamodb:eu-central-1:ACCOUNT_ID:table/hartolit-field-passport-staging-WebRevalidationTable-*"
    },
    {
      "Sid": "PageCacheInvalidation",
      "Effect": "Allow",
      "Action": "cloudfront:CreateInvalidation",
      "Resource": "arn:aws:cloudfront::ACCOUNT_ID:distribution/*"
    }
  ]
}
