
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String      @id
  name             String
  email            String
  emailVerified    Boolean     @default(false)
  image            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  role             String?
  banned           Boolean?    @default(false)
  banReason        String?
  banExpires       DateTime?
  twoFactorEnabled Boolean?    @default(false)
  sessions         Session[]
  accounts         Account[]
  twofactors       TwoFactor[]
  farmers          Farmer[]
  fields           Field[]
  passports        Passport[]
  evidenceFiles    EvidenceFile[]
  assignedReviews  Passport[] @relation("AssignedReviewer")
  reviewedPassports Passport[] @relation("DecisionReviewer")

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

enum PassportStatus {
  DRAFT
  SUBMITTED
  REJECTED
  CORRECTION_REQUIRED
  APPROVED
  PUBLISHING
  PUBLISHED
  FAILED_RETRYABLE
}

enum EvidenceStatus {
  PENDING
  SCANNING
  QUARANTINED
  READY
  REJECTED
}

enum EvidenceKind {
  METEO
  CHEMICAL
  OTHER
}

enum PublicationStatus {
  RESERVED
  PINNING
  CHAIN_PENDING
  PUBLISHED
  FAILED_RETRYABLE
}

enum AuditAction {
  DRAFT_CREATED
  DRAFT_UPDATED
  EVIDENCE_RESERVED
  EVIDENCE_READY
  EVIDENCE_REJECTED
  EVIDENCE_REMOVED
  PASSPORT_SUBMITTED
  REVIEW_ASSIGNED
  REVIEW_APPROVED
  REVIEW_REJECTED
  CORRECTION_REQUESTED
  PASSPORT_REOPENED
}

model Farmer {
  id             String   @id @default(uuid()) @db.Uuid
  ownerId        String
  owner          User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  legalName      String?  @db.VarChar(200)
  registrationId String?  @db.VarChar(32)
  contactName    String?  @db.VarChar(200)
  contactEmail   String?  @db.VarChar(320)
  contactPhone   String?  @db.VarChar(40)
  archivedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  fields         Field[]
  passports      Passport[]

  @@unique([id, ownerId])
  @@index([ownerId, legalName])
  @@index([ownerId, registrationId])
}

model Field {
  id               String   @id @default(uuid()) @db.Uuid
  ownerId          String
  owner            User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  farmerId         String   @db.Uuid
  farmer           Farmer   @relation(fields: [farmerId, ownerId], references: [id, ownerId], onDelete: Restrict)
  label            String?  @db.VarChar(200)
  areaHectares     Decimal? @db.Decimal(12, 4)
  gpsCoords        String?  @db.VarChar(80)
  cadastralNumber  String?  @db.VarChar(40)
  crop             String?  @db.VarChar(100)
  archivedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  passports        Passport[]

  @@unique([id, ownerId])
  @@index([ownerId, cadastralNumber])
  @@index([farmerId])
}

model Passport {
  id          String         @id @default(uuid()) @db.Uuid
  ownerId     String
  owner       User           @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  farmerId    String         @db.Uuid
  farmer      Farmer         @relation(fields: [farmerId, ownerId], references: [id, ownerId], onDelete: Restrict)
  fieldId     String         @db.Uuid
  field       Field          @relation(fields: [fieldId, ownerId], references: [id, ownerId], onDelete: Restrict)
  status      PassportStatus @default(DRAFT)
  version     Int            @default(1)
  submittedAt DateTime?
  submittedVersion Int?
  reviewerId  String?
  reviewer    User?          @relation("AssignedReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  assignedAt  DateTime?
  reviewedById String?
  reviewedBy  User?          @relation("DecisionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt  DateTime?
  approvedVersion Int?
  reviewNote  String?        @db.VarChar(1000)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  treatment   Treatment?
  meteo       MeteoMeasurement?
  chemical    ChemicalApplication?
  evidence    EvidenceFile[]
  publication Publication?
  audit       AuditLog[]

  @@unique([id, ownerId])
  @@index([ownerId, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([status, updatedAt(sort: Desc)])
  @@index([status, reviewerId, submittedAt(sort: Desc)])
}

model Treatment {
  id            String   @id @default(uuid()) @db.Uuid
  passportId    String   @unique @db.Uuid
  passport      Passport @relation(fields: [passportId], references: [id], onDelete: Restrict)
  treatmentType String?  @db.VarChar(100)
  treatmentDate String?  @db.VarChar(10)
  treatmentTime String?  @db.VarChar(5)
  droneModel    String?  @db.VarChar(200)
  droneSerial   String?  @db.VarChar(200)
  operator      String?  @db.VarChar(200)
  pilotCert     String?  @db.VarChar(200)
  notes         String?  @db.VarChar(2000)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MeteoMeasurement {
  id                 String        @id @default(uuid()) @db.Uuid
  passportId         String        @unique @db.Uuid
  passport           Passport      @relation(fields: [passportId], references: [id], onDelete: Restrict)
  temperatureCelsius Decimal?      @db.Decimal(6, 2)
  humidityPercent    Decimal?      @db.Decimal(5, 2)
  windSpeedMps       Decimal?      @db.Decimal(6, 2)
  rainfallMm         Decimal?      @db.Decimal(7, 2)
  measuredAt         DateTime?
  sourceFileId       String?       @db.Uuid
  sourceFile         EvidenceFile? @relation("MeteoSource", fields: [sourceFileId], references: [id], onDelete: SetNull)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model ChemicalApplication {
  id                String        @id @default(uuid()) @db.Uuid
  passportId        String        @unique @db.Uuid
  passport          Passport      @relation(fields: [passportId], references: [id], onDelete: Restrict)
  product           String?       @db.VarChar(200)
  activeSubstance   String?       @db.VarChar(200)
  dosePerHa         Decimal?      @db.Decimal(12, 4)
  workingVolume     Decimal?      @db.Decimal(12, 4)
  manufacturer      String?       @db.VarChar(200)
  registrationNo    String?       @db.VarChar(100)
  supplierName      String?       @db.VarChar(200)
  supplierEdrpou    String?       @db.VarChar(32)
  sourceFileId      String?       @db.Uuid
  sourceFile        EvidenceFile? @relation("ChemicalSource", fields: [sourceFileId], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model EvidenceFile {
  id              String                @id @default(uuid()) @db.Uuid
  ownerId         String
  owner           User                  @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  passportId      String                @db.Uuid
  passport        Passport              @relation(fields: [passportId, ownerId], references: [id, ownerId], onDelete: Restrict)
  kind            EvidenceKind
  status          EvidenceStatus        @default(PENDING)
  objectKey       String                @unique @db.VarChar(512)
  filename        String                @db.VarChar(255)
  contentType     String                @db.VarChar(255)
  sizeBytes       Int
  sha256          String                @db.Char(64)
  uploadExpiresAt DateTime
  scanLeaseUntil  DateTime?
  rejectionCode   String?               @db.VarChar(40)
  objectPurgedAt  DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  meteoSources    MeteoMeasurement[]    @relation("MeteoSource")
  chemicalSources ChemicalApplication[] @relation("ChemicalSource")

  @@index([passportId, kind])
  @@index([ownerId, createdAt(sort: Desc)])
  @@index([status, uploadExpiresAt])
}

model Publication {
  id              String            @id @default(uuid()) @db.Uuid
  passportId      String            @unique @db.Uuid
  passport        Passport          @relation(fields: [passportId], references: [id], onDelete: Restrict)
  status          PublicationStatus @default(RESERVED)
  idempotencyKey  String            @unique @db.VarChar(128)
  publicSnapshot  Json?
  payloadHash     String?           @unique @db.Char(64)
  ipfsCid         String?           @db.VarChar(255)
  chainId         Int?
  contractAddress String?           @db.VarChar(42)
  transactionHash String?           @db.VarChar(66)
  tokenId         String?           @db.VarChar(78)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([chainId, contractAddress, tokenId])
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  passportId String      @db.Uuid
  passport   Passport    @relation(fields: [passportId], references: [id], onDelete: Restrict)
  actorId    String
  action     AuditAction
  version    Int
  fromStatus PassportStatus?
  toStatus   PassportStatus?
  note       String?     @db.VarChar(1000)
  targetUserId String?
  createdAt  DateTime    @default(now())

  @@index([passportId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
}
