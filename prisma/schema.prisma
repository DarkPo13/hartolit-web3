
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String      @id
  name             String
  email            String
  emailVerified    Boolean     @default(false)
  image            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  role             String?
  banned           Boolean?    @default(false)
  banReason        String?
  banExpires       DateTime?
  twoFactorEnabled Boolean?    @default(false)
  sessions         Session[]
  accounts         Account[]
  twofactors       TwoFactor[]
  farmers          Farmer[]
  fields           Field[]
  passports        Passport[]
  evidenceFiles    EvidenceFile[]
  assignedReviews  Passport[] @relation("AssignedReviewer")
  reviewedPassports Passport[] @relation("DecisionReviewer")
  confirmedSnapshots PublicSnapshotConfirmation[]
  publicationReservations Publication[]
  publicationWalletChallenges PublicationWalletChallenge[]
  adminActions     AdminAction[]
  productFeedback  ProductFeedback[]
  mintRecoveries   PublicationMintRecovery[]
  mintFailures     PublicationMintFailure[]
  mintCancellations PublicationMintCancellation[]
  mintReanchors    PublicationMintReanchor[]
  publicationCorrections PublicationCorrection[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

enum PassportStatus {
  DRAFT
  SUBMITTED
  REJECTED
  CORRECTION_REQUIRED
  APPROVED
  PUBLISHING
  PUBLISHED
  FAILED_RETRYABLE
}

enum EvidenceStatus {
  PENDING
  SCANNING
  QUARANTINED
  READY
  REJECTED
}

enum EvidenceKind {
  METEO
  CHEMICAL
  OTHER
}

enum DoseUnit {
  L_PER_HA
  KG_PER_HA
}

enum PublicationStatus {
  RESERVED
  PINNING
  PINNED
  CHAIN_PENDING
  CHAIN_SUSPENDED
  CHAIN_FAILED
  CHAIN_FAILED_SUSPENDED
  PUBLISHED
  FAILED_RETRYABLE
  CANCELLED
}

enum PublicationPinAttemptStatus {
  PREPARED
  DISPATCHING
  UNKNOWN
  CANCELLED
  VERIFIED
}

enum PublicationMintAttemptStatus {
  DISPATCHING
  UNKNOWN
  FINALIZED
  FAILED_TERMINAL
}

enum PublicationMintRecoveryKind {
  SUCCESS
  FAILURE
  CANCELLATION
}

enum PublicationMintObservationStatus {
  UNKNOWN
  UNAVAILABLE
  MISMATCH
  PENDING
  CONFIRMING
  VERIFIED
  REVERTED
  CANCELLED
  REORG
}

enum PublicationMintResultStatus {
  VERIFIED
  SUSPENDED
}

enum PublicationMintDiscoveryStatus {
  FOUND
  CONFLICT
  SCANNED
  CAUGHT_UP
  REORG
  UNAVAILABLE
}

enum AuditAction {
  DRAFT_CREATED
  DRAFT_UPDATED
  ADMIN_RECORD_UPDATED
  EVIDENCE_RESERVED
  EVIDENCE_READY
  EVIDENCE_REJECTED
  EVIDENCE_REMOVED
  PASSPORT_SUBMITTED
  REVIEW_ASSIGNED
  REVIEW_APPROVED
  REVIEW_REJECTED
  CORRECTION_REQUESTED
  PASSPORT_REOPENED
  PUBLIC_SNAPSHOT_CONFIRMED
  PUBLICATION_RESERVED
  PUBLICATION_CANCELLED
  PUBLICATION_WALLET_CHALLENGED
  PUBLICATION_WALLET_VERIFIED
  PUBLICATION_PIN_PREPARED
  PUBLICATION_PIN_DISPATCH_STARTED
  PUBLICATION_PIN_OUTCOME_UNKNOWN
  PUBLICATION_PIN_CANCELLED
  PUBLICATION_PIN_VERIFIED
  PUBLICATION_MINT_PREPARED
  PUBLICATION_MINT_DISPATCH_STARTED
  PUBLICATION_MINT_OUTCOME_UNKNOWN
  PUBLICATION_MINT_OBSERVED
  PUBLICATION_MINT_RESULT_CHECKED
  PUBLICATION_MINT_FINALIZED
  PUBLICATION_MINT_QUARANTINED
  PUBLICATION_MINT_SEARCHED
  PUBLICATION_MINT_RESTORED
  PUBLICATION_MINT_FAILED
  PUBLICATION_MINT_FAILURE_RESTORED
  PUBLICATION_MINT_CANCELLED
  PUBLICATION_MINT_CANCELLATION_RESTORED
  PUBLICATION_MINT_REANCHORED
  PUBLICATION_WITHDRAWN
  PUBLICATION_CORRECTION_OPENED
}

model Farmer {
  id             String   @id @default(uuid()) @db.Uuid
  ownerId        String
  owner          User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  legalName      String?  @db.VarChar(200)
  registrationId String?  @db.VarChar(32)
  contactName    String?  @db.VarChar(200)
  contactEmail   String?  @db.VarChar(320)
  contactPhone   String?  @db.VarChar(40)
  archivedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  fields         Field[]
  passports      Passport[]

  @@unique([id, ownerId])
  @@index([ownerId, legalName])
  @@index([ownerId, registrationId])
}

model Field {
  id               String   @id @default(uuid()) @db.Uuid
  publicReference  String   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId          String
  owner            User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  farmerId         String   @db.Uuid
  farmer           Farmer   @relation(fields: [farmerId, ownerId], references: [id, ownerId], onDelete: Restrict)
  label            String?  @db.VarChar(200)
  areaHectares     Decimal? @db.Decimal(12, 4)
  gpsCoords        String?  @db.VarChar(80)
  cadastralNumber  String?  @db.VarChar(40)
  crop             String?  @db.VarChar(100)
  archivedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  passports        Passport[]

  @@unique([id, ownerId])
  @@index([ownerId, cadastralNumber])
  @@index([farmerId])
}

model Passport {
  id          String         @id @default(uuid()) @db.Uuid
  publicFarmLabel String?     @db.VarChar(200)
  ownerId     String
  owner       User           @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  farmerId    String         @db.Uuid
  farmer      Farmer         @relation(fields: [farmerId, ownerId], references: [id, ownerId], onDelete: Restrict)
  fieldId     String         @db.Uuid
  field       Field          @relation(fields: [fieldId, ownerId], references: [id, ownerId], onDelete: Restrict)
  status      PassportStatus @default(DRAFT)
  version     Int            @default(1)
  submittedAt DateTime?
  submittedVersion Int?
  reviewerId  String?
  reviewer    User?          @relation("AssignedReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  assignedAt  DateTime?
  reviewedById String?
  reviewedBy  User?          @relation("DecisionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt  DateTime?
  approvedVersion Int?
  reviewNote  String?        @db.VarChar(1000)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  treatment   Treatment?
  meteo       MeteoMeasurement?
  chemical    ChemicalApplication?
  evidence    EvidenceFile[]
  publications Publication[]
  confirmedSnapshots PublicSnapshotConfirmation[]
  audit       AuditLog[]

  supersededBy    PublicationCorrection[] @relation("CorrectionSupersededPassport")
  correctionOf    PublicationCorrection[] @relation("CorrectionReplacementPassport")

  @@unique([id, ownerId])
  @@index([ownerId, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([status, updatedAt(sort: Desc)])
  @@index([status, reviewerId, submittedAt(sort: Desc)])
}

model Treatment {
  id            String   @id @default(uuid()) @db.Uuid
  passportId    String   @unique @db.Uuid
  passport      Passport @relation(fields: [passportId], references: [id], onDelete: Restrict)
  treatmentType String?  @db.VarChar(100)
  treatmentDate String?  @db.VarChar(10)
  treatmentTime String?  @db.VarChar(5)
  timeZone      String?  @db.VarChar(64)
  treatedAreaHectares Decimal? @db.Decimal(12, 4)
  droneModel    String?  @db.VarChar(200)
  droneSerial   String?  @db.VarChar(200)
  operator      String?  @db.VarChar(200)
  pilotCert     String?  @db.VarChar(200)
  notes         String?  @db.VarChar(2000)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MeteoMeasurement {
  id                 String        @id @default(uuid()) @db.Uuid
  passportId         String        @unique @db.Uuid
  passport           Passport      @relation(fields: [passportId], references: [id], onDelete: Restrict)
  temperatureCelsius Decimal?      @db.Decimal(6, 2)
  humidityPercent    Decimal?      @db.Decimal(5, 2)
  windSpeedMps       Decimal?      @db.Decimal(6, 2)
  rainfallMm         Decimal?      @db.Decimal(7, 2)
  measuredAt         DateTime?
  sourceFileId       String?       @db.Uuid
  sourceFile         EvidenceFile? @relation("MeteoSource", fields: [sourceFileId], references: [id], onDelete: SetNull)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model ChemicalApplication {
  id                String        @id @default(uuid()) @db.Uuid
  passportId        String        @unique @db.Uuid
  passport          Passport      @relation(fields: [passportId], references: [id], onDelete: Restrict)
  product           String?       @db.VarChar(200)
  activeSubstance   String?       @db.VarChar(200)
  dosePerHa         Decimal?      @db.Decimal(12, 4)
  doseUnit          DoseUnit?
  workingVolume     Decimal?      @db.Decimal(12, 4)
  manufacturer      String?       @db.VarChar(200)
  registrationNo    String?       @db.VarChar(100)
  supplierName      String?       @db.VarChar(200)
  supplierEdrpou    String?       @db.VarChar(32)
  sourceFileId      String?       @db.Uuid
  sourceFile        EvidenceFile? @relation("ChemicalSource", fields: [sourceFileId], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model EvidenceFile {
  id              String                @id @default(uuid()) @db.Uuid
  ownerId         String
  owner           User                  @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  passportId      String                @db.Uuid
  passport        Passport              @relation(fields: [passportId, ownerId], references: [id, ownerId], onDelete: Restrict)
  kind            EvidenceKind
  status          EvidenceStatus        @default(PENDING)
  objectKey       String                @unique @db.VarChar(512)
  filename        String                @db.VarChar(255)
  contentType     String                @db.VarChar(255)
  sizeBytes       Int
  sha256          String                @db.Char(64)
  uploadExpiresAt DateTime
  scanLeaseUntil  DateTime?
  rejectionCode   String?               @db.VarChar(40)
  objectPurgedAt  DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  meteoSources    MeteoMeasurement[]    @relation("MeteoSource")
  chemicalSources ChemicalApplication[] @relation("ChemicalSource")
  confirmedWeatherSnapshots PublicSnapshotConfirmation[] @relation("ConfirmedWeatherFile")
  confirmedChemicalSnapshots PublicSnapshotConfirmation[] @relation("ConfirmedChemicalFile")

  @@index([passportId, kind])
  @@index([ownerId, createdAt(sort: Desc)])
  @@index([status, uploadExpiresAt])
}

model Publication {
  id              String            @id @default(uuid()) @db.Uuid
  passportId      String            @db.Uuid
  passport        Passport          @relation(fields: [passportId], references: [id], onDelete: Restrict)
  confirmationId  String            @unique @db.Uuid
  confirmation    PublicSnapshotConfirmation @relation(fields: [confirmationId, passportId], references: [id, passportId], onDelete: Restrict)
  reservedById    String
  reservedBy      User              @relation(fields: [reservedById], references: [id], onDelete: Restrict)
  publisherWallet String            @db.VarChar(42)
  passportVersion Int
  approvedVersion Int
  status          PublicationStatus @default(RESERVED)
  idempotencyKey  String            @unique @db.VarChar(128)
  canonicalJson   String            @db.Text
  payloadHash     String            @unique @db.Char(64)
  ipfsCid         String?           @db.VarChar(255)
  chainId         Int?
  contractAddress String?           @db.VarChar(42)
  transactionHash String?           @db.VarChar(66)
  tokenId         String?           @db.VarChar(78)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  cancelledAt     DateTime?
  walletVerifiedAt DateTime?
  walletChallenges PublicationWalletChallenge[]
  pinAttempts     PublicationPinAttempt[]
  mintPreparation PublicationMintPreparation?
  audit           AuditLog[]

  corrections     PublicationCorrection[]

  @@unique([chainId, contractAddress, tokenId])
  @@unique([id, passportId])
  @@unique([confirmationId, passportId])
  @@index([passportId, status])
}

model PublicationWalletChallenge {
  id            String      @id @default(uuid()) @db.Uuid
  publicationId String      @db.Uuid
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  actorId       String
  actor         User        @relation(fields: [actorId], references: [id], onDelete: Restrict)
  walletAddress String      @db.VarChar(42)
  origin        String      @db.VarChar(255)
  nonce         String      @unique @db.Char(64)
  message       String      @db.Text
  createdAt     DateTime    @default(now())
  expiresAt     DateTime
  consumedAt    DateTime?
  invalidatedAt DateTime?
  signature     String?     @db.VarChar(132)
  pinAttempts   PublicationPinAttempt[]

  @@unique([id, publicationId])
  @@index([publicationId, createdAt(sort: Desc)])
}

model PublicationPinAttempt {
  id                String @id @default(uuid()) @db.Uuid
  publicationId     String @db.Uuid
  publication       Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  walletChallengeId String @db.Uuid
  walletChallenge   PublicationWalletChallenge @relation(fields: [walletChallengeId, publicationId], references: [id, publicationId], onDelete: Restrict)
  requestId         String @unique @db.Uuid
  status            PublicationPinAttemptStatus @default(PREPARED)
  createdAt         DateTime @default(now())
  dispatchedAt      DateTime?
  deadlineAt        DateTime?
  closedAt          DateTime?
  expectedCid       String? @db.VarChar(255)
  providerKey       String? @db.VarChar(80)
  providerConfigHash String? @db.Char(64)
  storageProfile    String? @db.VarChar(64)
  verifiedCid       String? @db.VarChar(255)
  providerPinId     String? @db.VarChar(128)
  verifiedAt        DateTime?
  mintPreparation   PublicationMintPreparation?

  @@unique([id, publicationId])
  @@index([publicationId, createdAt(sort: Desc)])
  @@index([status, deadlineAt])
}

// Private immutable planning only; no nonce, transaction, dispatch or issuance.
model PublicationMintPreparation {
  id            String @id @default(uuid()) @db.Uuid
  publicationId String @unique @db.Uuid
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  pinAttemptId  String @unique @db.Uuid
  pinAttempt    PublicationPinAttempt @relation(fields: [pinAttemptId, publicationId], references: [id, publicationId], onDelete: Restrict)
  requestId     String @unique @db.Uuid
  intentJson    String @db.Text
  intentSha256  String @db.Char(64)
  createdAt     DateTime @default(now())

  attempt       PublicationMintAttempt?
  @@unique([pinAttemptId, publicationId])
}

model PublicationMintAttempt {
  id              String @id @default(uuid()) @db.Uuid
  preparationId   String @unique @db.Uuid
  preparation     PublicationMintPreparation @relation(fields: [preparationId], references: [id], onDelete: Restrict)
  requestId       String @unique @db.Uuid
  chainId         Int
  publisherWallet String @db.VarChar(42)
  nonce           BigInt
  status          PublicationMintAttemptStatus @default(DISPATCHING)
  createdAt       DateTime @default(now())
  deadlineAt      DateTime
  unknownAt       DateTime?
  observationVersion Int @default(0)
  transactions    PublicationMintTransaction[]
  observations    PublicationMintObservation[]
  result          PublicationMintResult?
  finalizedAt     DateTime?
  finalizedObservationId String? @unique @db.Uuid
  finalizationStatus PublicationMintObservationStatus?
  finalizedObservation PublicationMintObservation? @relation("MintFinalization", fields: [finalizedObservationId, id, finalizationStatus], references: [id, attemptId, status], onDelete: NoAction)
  quarantinedAt   DateTime?
  dispatchBlockNumber BigInt?
  dispatchBlockHash String? @db.VarChar(66)
  discoveryVersion Int @default(0)
  discoveryBlockNumber BigInt?
  discoveryBlockHash String? @db.VarChar(66)
  discoveries PublicationMintDiscovery[]
  monitorToken    String? @db.Uuid
  monitorUntil    DateTime?
  monitorNextAt   DateTime @default(now())
  recoveries      PublicationMintRecovery[]
  failedAt        DateTime?
  failedObservationId String? @unique @db.Uuid
  failureStatus   PublicationMintObservationStatus?
  failedObservation PublicationMintObservation? @relation("MintFailureProof", fields: [failedObservationId, id, failureStatus], references: [id, attemptId, status], onDelete: NoAction, map: "PublicationMintAttempt_failure_proof_fkey")
  failure         PublicationMintFailure?
  cancellation    PublicationMintCancellation?
  // Current canonical inclusion of the unchanged first transaction after a
  // reviewed re-inclusion; null means the first proof is still the anchor.
  anchorObservationId String? @db.Uuid
  currentReanchor PublicationMintReanchor? @relation("MintCurrentAnchor", fields: [id, anchorObservationId], references: [attemptId, anchorObservationId], onDelete: NoAction, map: "PublicationMintAttempt_anchor_fkey")
  reanchors       PublicationMintReanchor[] @relation("MintReanchors")
  firstSuccessReanchors PublicationMintReanchor[] @relation("MintReanchorFirstSuccess")
  firstFailureReanchors PublicationMintReanchor[] @relation("MintReanchorFirstFailure")

  @@unique([id, nonce])
  @@unique([id, anchorObservationId])
  @@unique([finalizedObservationId, id, finalizationStatus])
  @@unique([failedObservationId, id, failureStatus])
  @@unique([chainId, publisherWallet, nonce])
  @@index([status, deadlineAt])
  @@index([monitorNextAt, id])
}

// A hash enters this table only after exact call AND nonce matching, not from a report alone.
model PublicationMintTransaction {
  id              String @id @default(uuid()) @db.Uuid
  attemptId       String @db.Uuid
  nonce           BigInt
  attempt         PublicationMintAttempt @relation(fields: [attemptId, nonce], references: [id, nonce], onDelete: Restrict)
  transactionHash String @unique @db.VarChar(66)
  createdAt       DateTime @default(now())
  observations    PublicationMintObservation[]
  discoveries     PublicationMintDiscovery[]

  @@unique([id, attemptId])
  @@unique([id, attemptId, transactionHash])
  @@index([attemptId])
}

// Append-only in application code; every row describes one historical read, never issuance.
model PublicationMintObservation {
  id              String @id @default(uuid()) @db.Uuid
  attemptId       String @db.Uuid
  attempt         PublicationMintAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  revision        Int
  reportedHash    String? @db.VarChar(66)
  transactionId   String? @db.Uuid
  transaction     PublicationMintTransaction? @relation(fields: [transactionId, attemptId], references: [id, attemptId], onDelete: Restrict)
  status          PublicationMintObservationStatus
  resultJson      String @db.Text
  observedAt      DateTime @default(now())
  checkedResult   PublicationMintResult? @relation("MintResultCheck")
  verifiedResult  PublicationMintResult? @relation("MintResultVerification")
  finalizedAttempt PublicationMintAttempt? @relation("MintFinalization")
  recoveryOriginals PublicationMintRecovery[] @relation("MintRecoveryOriginal")
  failedRecoveryOriginals PublicationMintRecovery[] @relation("MintFailureRecoveryOriginal")
  recoveryVerification PublicationMintRecovery? @relation("MintRecoveryVerification")
  failedAttempt PublicationMintAttempt? @relation("MintFailureProof")
  failureClosure PublicationMintFailure? @relation("MintFailureClosure")
  cancellationClosure PublicationMintCancellation? @relation("MintCancellationClosure")
  reanchorFirstSuccess PublicationMintReanchor[] @relation("MintReanchorFirstSuccessProof")
  reanchorFirstFailure PublicationMintReanchor[] @relation("MintReanchorFirstFailureProof")
  reanchorProofs  PublicationMintReanchor[] @relation("MintReanchorProof")

  @@unique([attemptId, revision])
  @@unique([id, attemptId])
  @@unique([id, attemptId, status])
  @@unique([id, attemptId, transactionId, status], map: "PublicationMintObservation_failure_binding_key")
  @@unique([id, attemptId, reportedHash, status], map: "PublicationMintObservation_cancellation_binding_key")
}

// Reviewed consumed-nonce failure; never permission to resend this preparation.
model PublicationMintFailure {
  id              String @id @default(uuid()) @db.Uuid
  attemptId       String @unique @db.Uuid
  attempt         PublicationMintAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  requestId       String @unique @db.Uuid
  actorId         String
  actor           User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  observationId   String @unique @db.Uuid
  proofStatus     PublicationMintObservationStatus @default(REVERTED)
  observation     PublicationMintObservation @relation("MintFailureClosure", fields: [observationId, attemptId, transactionId, proofStatus], references: [id, attemptId, transactionId, status], onDelete: Restrict, map: "PublicationMintFailure_proof_fkey")
  transactionId   String @db.Uuid
  reviewedObservationVersion Int
  intentSha256    String @db.Char(64)
  walletStateSha256 String @db.Char(64)
  closedAt        DateTime @default(now())

  @@unique([observationId, attemptId, transactionId, proofStatus])
}

// Reviewed canonical self-send; separate from exact-call REVERTED mint proofs.
model PublicationMintCancellation {
  id              String @id @default(uuid()) @db.Uuid
  attemptId       String @unique @db.Uuid
  attempt         PublicationMintAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  requestId       String @unique @db.Uuid
  actorId         String
  actor           User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  discoveryId     String @db.Uuid
  discoveryStatus PublicationMintDiscoveryStatus @default(CONFLICT)
  discovery       PublicationMintDiscovery @relation(fields: [discoveryId, attemptId, transactionHash, discoveryStatus], references: [id, attemptId, transactionHash, status], onDelete: Restrict, map: "PublicationMintCancellation_discovery_fkey")
  transactionHash String @db.VarChar(66)
  observationId   String @unique @db.Uuid
  proofStatus     PublicationMintObservationStatus @default(CANCELLED)
  observation     PublicationMintObservation @relation("MintCancellationClosure", fields: [observationId, attemptId, transactionHash, proofStatus], references: [id, attemptId, reportedHash, status], onDelete: Restrict, map: "PublicationMintCancellation_proof_fkey")
  reviewedObservationVersion Int
  reviewedDiscoveryVersion Int
  intentSha256    String @db.Char(64)
  walletStateSha256 String @db.Char(64)
  closedAt        DateTime @default(now())
  recoveries      PublicationMintRecovery[]

  @@unique([observationId, attemptId, transactionHash, proofStatus])
  @@unique([id, attemptId, observationId])
  @@index([discoveryId])
  @@index([actorId])
}

// Append-only post-mint correction: a published record is never edited. It is
// linked to a separately approved passport for the same owner/farm/field whose
// own publication, once issued, supersedes it on the public page.
model PublicationCorrection {
  id                      String @id @default(uuid()) @db.Uuid
  supersededPublicationId String @unique @db.Uuid
  supersededPassportId    String @db.Uuid
  supersededPublication   Publication @relation(fields: [supersededPublicationId, supersededPassportId], references: [id, passportId], onDelete: Restrict, map: "PublicationCorrection_superseded_publication_fkey")
  ownerId                 String
  supersededPassport      Passport @relation("CorrectionSupersededPassport", fields: [supersededPassportId, ownerId], references: [id, ownerId], onDelete: Restrict, map: "PublicationCorrection_superseded_passport_fkey")
  correctionPassportId    String @unique @db.Uuid
  correctionPassport      Passport @relation("CorrectionReplacementPassport", fields: [correctionPassportId, ownerId], references: [id, ownerId], onDelete: Restrict, map: "PublicationCorrection_correction_passport_fkey")
  actorId                 String
  actor                   User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  reason                  String @db.VarChar(500)
  openedAt                DateTime @default(now())

  @@index([supersededPassportId])
  @@index([actorId])
}

// Append-only verified wallet checkpoint: every closed proof up to
// coveredThroughNonce had its current anchor at or below this canonical block.
// Later checks verify this block plus only the proofs after it.
model PublicationMintWalletCheckpoint {
  id                   String @id @default(uuid()) @db.Uuid
  chainId              Int
  publisherWallet      String @db.VarChar(42)
  sequence             Int
  baseCheckpointId     String? @db.Uuid
  base                 PublicationMintWalletCheckpoint? @relation("MintWalletCheckpointBase", fields: [baseCheckpointId, chainId, publisherWallet], references: [id, chainId, publisherWallet], onDelete: Restrict, map: "PublicationMintWalletCheckpoint_base_fkey")
  successors           PublicationMintWalletCheckpoint[] @relation("MintWalletCheckpointBase")
  coveredThroughNonce  BigInt
  coveredCount         Int
  coveredReanchorCount Int
  blockNumber          BigInt
  blockHash            String @db.VarChar(66)
  confirmations        Int
  headBlockNumber      BigInt
  headBlockHash        String @db.VarChar(66)
  coveredSha256        String @db.Char(64)
  createdAt            DateTime @default(now())

  @@unique([chainId, publisherWallet, sequence])
  @@unique([id, chainId, publisherWallet])
}

// Append-only reviewed adoption of a new canonical inclusion for the SAME first
// transaction and outcome. The first proof stays immutable history.
model PublicationMintReanchor {
  id                  String @id @default(uuid()) @db.Uuid
  attemptId           String @db.Uuid
  attempt             PublicationMintAttempt @relation("MintReanchors", fields: [attemptId], references: [id], onDelete: Restrict)
  requestId           String @unique @db.Uuid
  actorId             String
  actor               User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  quarantinedAt       DateTime
  reviewedObservationVersion Int
  intentSha256        String @db.Char(64)
  walletStateSha256   String @db.Char(64)
  transactionHash     String @db.VarChar(66)
  proofStatus         PublicationMintObservationStatus
  finalizedObservationId String? @db.Uuid
  failedObservationId String? @db.Uuid
  firstSuccess        PublicationMintAttempt? @relation("MintReanchorFirstSuccess", fields: [finalizedObservationId, attemptId, proofStatus], references: [finalizedObservationId, id, finalizationStatus], onDelete: Restrict, map: "PublicationMintReanchor_first_success_fkey")
  firstFailure        PublicationMintAttempt? @relation("MintReanchorFirstFailure", fields: [failedObservationId, attemptId, proofStatus], references: [failedObservationId, id, failureStatus], onDelete: Restrict, map: "PublicationMintReanchor_first_failure_fkey")
  firstSuccessProof   PublicationMintObservation? @relation("MintReanchorFirstSuccessProof", fields: [finalizedObservationId, attemptId, transactionHash, proofStatus], references: [id, attemptId, reportedHash, status], onDelete: Restrict, map: "PublicationMintReanchor_first_success_proof_fkey")
  firstFailureProof   PublicationMintObservation? @relation("MintReanchorFirstFailureProof", fields: [failedObservationId, attemptId, transactionHash, proofStatus], references: [id, attemptId, reportedHash, status], onDelete: Restrict, map: "PublicationMintReanchor_first_failure_proof_fkey")
  previousAnchorObservationId String? @db.Uuid
  previous            PublicationMintReanchor? @relation("MintReanchorChain", fields: [attemptId, previousAnchorObservationId], references: [attemptId, anchorObservationId], onDelete: Restrict, map: "PublicationMintReanchor_previous_fkey")
  next                PublicationMintReanchor[] @relation("MintReanchorChain")
  anchorObservationId String @unique @db.Uuid
  anchorObservation   PublicationMintObservation @relation("MintReanchorProof", fields: [anchorObservationId, attemptId, transactionHash, proofStatus], references: [id, attemptId, reportedHash, status], onDelete: Restrict, map: "PublicationMintReanchor_anchor_proof_fkey")
  currentFor          PublicationMintAttempt? @relation("MintCurrentAnchor")
  reanchoredAt        DateTime @default(now())

  @@unique([attemptId, anchorObservationId])
  @@unique([attemptId, reviewedObservationVersion])
  @@index([attemptId, reanchoredAt])
  @@index([actorId])
}

// Append-only explicit review of an unchanged original receipt after quarantine.
model PublicationMintRecovery {
  id                        String @id @default(uuid()) @db.Uuid
  attemptId                 String @db.Uuid
  attempt                   PublicationMintAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  requestId                 String @unique @db.Uuid
  actorId                   String
  actor                     User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  quarantinedAt             DateTime
  reviewedObservationVersion Int
  intentSha256              String @db.Char(64)
  walletStateSha256         String @db.Char(64)
  kind                      PublicationMintRecoveryKind @default(SUCCESS)
  finalizedObservationId    String? @db.Uuid
  failedObservationId       String? @db.Uuid
  verifiedObservationId     String @unique @db.Uuid
  verificationStatus        PublicationMintObservationStatus @default(VERIFIED)
  original                  PublicationMintObservation? @relation("MintRecoveryOriginal", fields: [finalizedObservationId, attemptId, verificationStatus], references: [id, attemptId, status], onDelete: Restrict)
  failedOriginal            PublicationMintObservation? @relation("MintFailureRecoveryOriginal", fields: [failedObservationId, attemptId, verificationStatus], references: [id, attemptId, status], onDelete: Restrict, map: "PublicationMintRecovery_failed_original_fkey")
  verification              PublicationMintObservation @relation("MintRecoveryVerification", fields: [verifiedObservationId, attemptId, verificationStatus], references: [id, attemptId, status], onDelete: Restrict)
  // CANCELLATION restores only the reviewed closure's own first proof.
  cancellationId            String? @db.Uuid
  cancellation              PublicationMintCancellation? @relation(fields: [cancellationId, attemptId, failedObservationId], references: [id, attemptId, observationId], onDelete: Restrict, map: "PublicationMintRecovery_cancellation_fkey")
  restoredAt                DateTime @default(now())

  @@unique([attemptId, reviewedObservationVersion])
  @@unique([verifiedObservationId, attemptId, verificationStatus])
  @@index([attemptId, restoredAt])
  @@index([cancellationId])
}

// Append-only search pages. FOUND adopts an exact call/nonce, never a receipt or issuance.
model PublicationMintDiscovery {
  id                  String @id @default(uuid()) @db.Uuid
  attemptId           String @db.Uuid
  attempt             PublicationMintAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  revision            Int
  status              PublicationMintDiscoveryStatus
  fromBlock           BigInt?
  throughBlock        BigInt?
  throughBlockHash    String? @db.VarChar(66)
  headBlock           BigInt?
  headBlockHash       String? @db.VarChar(66)
  scannedBlocks       Int @default(0)
  scannedTransactions Int @default(0)
  resetToDispatchAnchor Boolean @default(false)
  transactionHash     String? @db.VarChar(66)
  transactionId       String? @db.Uuid
  transaction         PublicationMintTransaction? @relation(fields: [transactionId, attemptId, transactionHash], references: [id, attemptId, transactionHash], onDelete: Restrict)
  observedAt          DateTime @default(now())
  cancellations       PublicationMintCancellation[]

  @@unique([attemptId, revision])
  @@unique([id, attemptId, transactionHash, status], map: "PublicationMintDiscovery_cancellation_binding_key")
}

// A revocable, as-of projection. Never issuance, finality or permission to release a nonce.
model PublicationMintResult {
  attemptId               String @id @db.Uuid
  attempt                 PublicationMintAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  status                  PublicationMintResultStatus
  checkedObservationId    String @unique @db.Uuid
  checkedObservation      PublicationMintObservation @relation("MintResultCheck", fields: [checkedObservationId, attemptId], references: [id, attemptId], onDelete: Restrict)
  verifiedObservationId   String? @unique @db.Uuid
  verificationStatus      PublicationMintObservationStatus?
  verifiedObservation     PublicationMintObservation? @relation("MintResultVerification", fields: [verifiedObservationId, attemptId, verificationStatus], references: [id, attemptId, status], onDelete: Restrict)

  @@unique([checkedObservationId, attemptId])
  @@unique([verifiedObservationId, attemptId, verificationStatus])
}

model PublicSnapshotConfirmation {
  id               String       @id @default(uuid()) @db.Uuid
  passportId       String       @db.Uuid
  passport         Passport     @relation(fields: [passportId], references: [id], onDelete: Restrict)
  approvedVersion  Int
  passportVersion  Int
  certificateId    String       @unique @db.Uuid
  canonicalJson    String       @db.Text
  payloadHash      String       @unique @db.Char(64)
  weatherFileId    String       @db.Uuid
  weatherFile      EvidenceFile @relation("ConfirmedWeatherFile", fields: [weatherFileId], references: [id], onDelete: Restrict)
  chemicalFileId   String       @db.Uuid
  chemicalFile     EvidenceFile @relation("ConfirmedChemicalFile", fields: [chemicalFileId], references: [id], onDelete: Restrict)
  confirmedById    String
  confirmedBy      User         @relation(fields: [confirmedById], references: [id], onDelete: Restrict)
  confirmedAt      DateTime     @default(now())
  invalidatedAt    DateTime?
  publication      Publication?

  @@unique([id, passportId])
  @@unique([passportId, approvedVersion])
  @@index([passportId, invalidatedAt])
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  passportId String      @db.Uuid
  passport   Passport    @relation(fields: [passportId], references: [id], onDelete: Restrict)
  actorId    String
  action     AuditAction
  version    Int
  fromStatus PassportStatus?
  toStatus   PassportStatus?
  note       String?     @db.VarChar(1000)
  targetUserId String?
  publicationId String? @db.Uuid
  publication Publication? @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  createdAt  DateTime    @default(now())

  @@index([passportId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
}

model AdminAction {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action    String   @db.VarChar(40)
  entity    String   @db.VarChar(20)
  entityId  String   @db.VarChar(191)
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([entity, entityId, createdAt(sort: Desc)])
}

model ProductFeedback {
  id        String   @id @db.Uuid
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String   @db.VarChar(2000)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
}
