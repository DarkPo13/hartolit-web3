# ---------- Public (client-safe) ----------
# WalletConnect Cloud project id — https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_ID=

# Deployed HartolitFieldPassport contract address
NEXT_PUBLIC_CONTRACT_ADDRESS=

# 97 = BSC Testnet, 56 = BSC Mainnet
NEXT_PUBLIC_CHAIN_ID=97

# Public base URL of the app (used in QR codes for /verify)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local prototype only. Production builds ignore this and disable all write APIs.
NEXT_PUBLIC_DEMO_MODE=false

# ---------- Server-only (NEVER expose to client) ----------
# PostgreSQL and individual account sessions. Generate local values with `npm run db:setup`.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# One designated MFA admin's database user ID and allowlisted Testnet wallet.
# Both are required for PRIVATE publication reservation. This does not enable
# public pinning/minting; wallet ownership must be proved before that later step.
HARTOLIT_PUBLISHER_USER_ID=
HARTOLIT_PUBLISHER_WALLET=

# Private preparation/consent only: server-owned raw-block target description.
# No uploader is enabled. Scope is a NON-SECRET account/namespace identifier.
# Origins must have no path/credentials; this describes the Kubo raw profile,
# not the standard Pinning Service API above/below. Leave blank until selected.
HARTOLIT_PUBLICATION_TARGET_KEY=
HARTOLIT_PUBLICATION_TARGET_SCOPE=
HARTOLIT_PUBLICATION_API_ORIGIN=
HARTOLIT_PUBLICATION_GATEWAY_ORIGIN=

# Private evidence bucket (S3-compatible). The endpoint must be reachable by both
# the application server and the user's browser for direct presigned uploads.
EVIDENCE_S3_BUCKET=
EVIDENCE_S3_REGION=
EVIDENCE_S3_ENDPOINT=
EVIDENCE_S3_ACCESS_KEY=
EVIDENCE_S3_SECRET_KEY=
# Set AES256 only when the bucket supports S3 managed server-side encryption.
EVIDENCE_S3_SSE=
EVIDENCE_CLAMD_HOST=
EVIDENCE_CLAMD_PORT=3310

# Transactional SMTP account required to deliver password reset links.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# BSC RPC URLs (used for public contract reads)
BSC_TESTNET_RPC=https://bsc-testnet-rpc.publicnode.com
BSC_MAINNET_RPC=https://bsc-rpc.publicnode.com

# Pinata IPFS JWT for stateless public uploads — https://app.pinata.cloud
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud

# Phase 5 readback only: standard IPFS Pinning Service API base URL (without /pins),
# its server-only bearer credential, and an HTTPS gateway origin supporting raw blocks.
# No upload, scheduler or publication endpoint is enabled by setting these values.
HARTOLIT_IPFS_PINNING_API_URL=
HARTOLIT_IPFS_PINNING_TOKEN=
HARTOLIT_IPFS_GATEWAY_URL=

# BSCScan API key — deployment/contract verification tooling only
BSCSCAN_API_KEY=

# The deployment script currently expects ADMIN_PRIVATE_KEY in the deployment
# shell. Never configure that key in the deployed website environment.
