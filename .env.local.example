# ---------- Public (client-safe) ----------
# WalletConnect Cloud project id — https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_ID=

# Deployed HartolitFieldPassport contract address
NEXT_PUBLIC_CONTRACT_ADDRESS=

# 97 = BSC Testnet, 56 = BSC Mainnet
NEXT_PUBLIC_CHAIN_ID=97

# Public base URL of the app (used in QR codes for /verify)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Server-only (NEVER expose to client) ----------
# Admin wallet that holds MINTER_ROLE — used by /api/mint
ADMIN_PRIVATE_KEY=

# BSC RPC URLs (used server-side for signing + reading)
BSC_TESTNET_RPC=https://bsc-testnet-rpc.publicnode.com
BSC_MAINNET_RPC=https://bsc-rpc.publicnode.com

# Pinata IPFS JWT — https://app.pinata.cloud
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud

# Diia.Signature credentials — https://diia.gov.ua/services/electronic-signature
DIIA_API_KEY=
DIIA_API_SECRET=
DIIA_BASE_URL=https://api.diia.gov.ua

# Optional: AWS S3 for uploaded meteo/chem documents
S3_BUCKET=
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: Supabase for off-chain user data / draft passports
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# BSCScan API key — for contract verification
BSCSCAN_API_KEY=
