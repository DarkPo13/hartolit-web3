{
  "name": "hartolit-field-passport",
  "version": "0.1.0",
  "private": true,
  "description": "Hartolit Digital Field Passport — on-chain ERC-721 certificates for agricultural drone treatments on BNB Chain",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:hash": "node --test tests/hash.test.mjs",
    "db:setup": "node scripts/setup-local-auth.mjs",
    "evidence:setup": "node scripts/setup-local-evidence.mjs",
    "evidence:up": "docker compose --env-file .env.db.local --env-file .env.storage.local up -d seaweedfs clamav",
    "evidence:configure": "node scripts/configure-local-evidence.mjs",
    "db:up": "docker compose --env-file .env.db.local up -d postgres",
    "dev:services:up": "docker compose --env-file .env.db.local up -d postgres mailpit",
    "db:down": "docker compose --env-file .env.db.local down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed:fictional": "node scripts/seed-fictional-draft.mjs",
    "drafts:smoke": "node scripts/smoke-drafts.mjs",
    "evidence:smoke": "node scripts/smoke-evidence.mjs",
    "review:smoke": "node scripts/smoke-review.mjs",
    "evidence:prune": "node scripts/prune-evidence.mjs",
    "auth:create-admin": "auth create-admin --config auth.cli.ts",
    "auth:create-operator": "auth create-admin --config auth.cli.ts --role user --yes",
    "auth:smoke": "node scripts/smoke-auth.mjs",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts -vvv",
    "contracts:deploy:testnet": "forge script contracts/script/Deploy.s.sol:Deploy --root contracts --rpc-url bsc_testnet --broadcast --verify"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1136.0",
    "@aws-sdk/s3-presigned-post": "3.1136.0",
    "@aws-sdk/s3-request-presigner": "3.1136.0",
    "@better-auth/prisma-adapter": "1.7.5",
    "@hookform/resolvers": "5.9.1",
    "@next/env": "16.3.5",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@rainbow-me/rainbowkit": "^2.2.3",
    "@react-pdf/renderer": "^4.1.5",
    "@tanstack/react-query": "^5.62.7",
    "better-auth": "1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next": "^16.3.5",
    "nodemailer": "10.0.8",
    "papaparse": "^5.4.1",
    "pg": "8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "viem": "^2.21.55",
    "wagmi": "^2.14.6",
    "zod": "4.6.5",
    "zustand": "^5.0.2"
  },
  "overrides": {
    "@coinbase/cdp-sdk": "1.49.2",
    "axios": "^1.20.0",
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4",
    "ws@^8.0.0": "^8.21.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.3.15",
    "@types/pg": "8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "auth": "1.7.5",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.3.5",
    "jiti": "2.7.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2"
  }
}
